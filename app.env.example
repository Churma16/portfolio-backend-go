# ==============================================================================
# Portfolio Go API - Environment Variables Template
# Copy this file to `app.env` and fill in your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
# Address where the Go HTTP server will listen
SERVER_ADDRESS=0.0.0.0:8080
# Host port mapping for Docker Compose
PORT=8080

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DB_DRIVER=postgres
POSTGRES_USER=root
POSTGRES_PASSWORD=secret
POSTGRES_DB=portfolio_go

# Full database connection string for native local development (non-Docker)
# For Docker, docker-compose will automatically use service name `postgres:5432`
DB_SOURCE=postgresql://root:secret@localhost:5432/portfolio_go?sslmode=disable

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
# Symmetric key for JWT/PASETO tokens (MUST BE EXACTLY 32 CHARACTERS)
TOKEN_SYMMETRIC_KEY=e011a20c87a922a8db29bcd28e6a536d

# ------------------------------------------------------------------------------
# 4. Redis Cache Configuration
# ------------------------------------------------------------------------------
# For local machine: localhost:6379
# For Docker Compose: redis:6379
REDIS_ADDRESS=localhost:6379

# ------------------------------------------------------------------------------
# 5. Email Service Configuration (Resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=contact@churma.codes

# ------------------------------------------------------------------------------
# 6. Inter-Service Communication
# ------------------------------------------------------------------------------
# Endpoint for invalidating Express API cache when Go updates data
EXPRESS_API_URL=https://api-express.churma.codes

# ------------------------------------------------------------------------------
# 7. Storage Provider Configuration
# ------------------------------------------------------------------------------
# Choose active storage driver: 'local' (offline local disk) or 'r2' (Cloudflare R2 Object Storage)
STORAGE_DRIVER=local

# Local storage folder settings (Used when STORAGE_DRIVER=local)
STORAGE_BASE_DIR=storage
STORAGE_PUBLIC_URL=/storage

# ------------------------------------------------------------------------------
# 8. Cloudflare R2 Object Storage (Required when STORAGE_DRIVER=r2)
# ------------------------------------------------------------------------------
# Cloudflare Account ID (Visible in Cloudflare dashboard URL)
R2_ACCOUNT_ID=007c8799fe5074e90a0d6f35c18709f7

# R2 API Token Access Key (Generate from R2 -> Manage R2 API Tokens -> Create API Token)
R2_ACCESS_KEY_ID=your_r2_access_key_id_here

# R2 API Token Secret Access Key
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Target Cloudflare R2 Bucket Name
R2_BUCKET_NAME=my-portfolio-assets

# Public CDN URL attached to your bucket (Custom Domain or Public Dev URL without trailing slash)
# Example: https://cdn.churma.codes or https://pub-xxxxxxxx.r2.dev
R2_PUBLIC_URL=https://cdn.churma.codes
